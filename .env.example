# Copy this file to .env and adjust the values for your machine.
# Docker Compose and the root Makefile both read .env automatically.

# Credentials for the local Postgres container
POSTGRES_USER=ukuran
POSTGRES_PASSWORD=ukuran
POSTGRES_DB=ukuran

# Connection string the backend uses to reach Postgres
DATABASE_URL=postgres://ukuran:ukuran@localhost:5432/ukuran?sslmode=disable

# Address the backend HTTP server listens on
HTTP_ADDR=:8080
